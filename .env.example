# 复制本文件为 .env 并填入你自己的值
# .env 已被仓库 .gitignore 忽略，不会上传到 GitHub，可放心放令牌

# GitHub 个人访问令牌（精细令牌，仅勾本仓库 Contents: Read and write）
GITHUB_TOKEN=在这里填你的GitHub令牌

# 仓库与分支（一般不用改）
GITHUB_REPO=zhaowu3377/zhaowu-home
GITHUB_BRANCH=main

# 后台管理令牌（请改成你自己的强密码，不要再用默认的 zhaowu2026）
ADMIN_TOKEN=改一个强密码

# 端口（默认 3000）
PORT=3000
